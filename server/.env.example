# Copy this file to .env and set the master key once.
SSC_MASTER_KEY=

# dev enables local test routes. prod requires Basic Auth (deb, prod).
SSC_ENV=dev
# Configure a prod admin and run init-admin once before starting the server.
# SSC_ADMIN_NAME=
# SSC_ADMIN_PASSWORD=
# Maximum time to read the full request, including upload body.
# SSC_SERVER_READ_TIMEOUT=10m

# Optional overrides for native startup and Docker Compose.
# SSC_SERVER_PORT=8080
# SSC_PUBLISH_PORT=8080
# SSC_FFPROBER_PATH=
# SSC_SCRATCH_SIZE=536870912
# SSC_LOGS_LOG_FILE=
# SSC_CONFIG=./config.yaml

# Native bind address. Compose supplies its own container bind address.
# SSC_SERVER_HOST=127.0.0.1

# Defaults resolve to /data in Docker. Keep container paths on that volume.
# SSC_DATABASE_PATH=./data/repository/ssc.db
# SSC_STORAGE_PATH=./data/audio
