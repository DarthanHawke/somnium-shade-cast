    "definitions": {
        "domain.UploadStatus": {
            "type": "string",
            "enum": [
                "queued",
                "processing",
                "ready",
                "failed"
            ],
            "x-enum-varnames": [
                "UploadQueued",
                "UploadProcessing",
                "UploadReady",
                "UploadFailed"
            ]
        },
        "dto.AlbumSummary": {
            "type": "object",
            "properties": {
                "public_id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "dto.ArtistSummary": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "public_id": {
                    "type": "string"
                }
            }
        },
        "dto.SuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "dto.TrackResponse": {
            "type": "object",
            "properties": {
                "album": {
                    "description": "Album содержит сведения об альбоме. Если трек не связан с альбомом,\nполе равно nil и передаётся как null.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.AlbumSummary"
                        }
                    ]
                },
                "artist": {
                    "$ref": "#/definitions/dto.ArtistSummary"
                },
                "bitrate_kbps": {
                    "type": "integer"
                },
                "channels": {
                    "description": "Число каналов аудио. Null, если неизвестно.",
                    "type": "integer"
                },
                "codec": {
                    "type": "string"
                },
                "cover_url": {
                    "description": "CoverURL содержит путь к обложке альбома.\nЕсли обложка не задана, поле передаётся как null.",
                    "type": "string"
                },
                "created_at": {
                    "description": "CreatedAt содержит время создания в миллисекундах с начала эпохи Unix.",
                    "type": "integer"
                },
                "disc_no": {
                    "type": "integer"
                },
                "duration_ms": {
                    "description": "DurationMS содержит длительность трека в миллисекундах.\nЕсли длительность неизвестна, поле передаётся как null.",
                    "type": "integer"
                },
                "lastfm_url": {
                    "type": "string"
                },
                "public_id": {
                    "type": "string"
                },
                "sample_rate": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "track_no": {
                    "type": "integer"
                },
                "updated_at": {
                    "description": "UpdatedAt содержит время последнего обновления в миллисекундах с начала эпохи Unix.",
                    "type": "integer"
                }
            }
        },
        "dto.TrackUploadResponse": {
            "type": "object",
            "properties": {
                "completed_at": {
                    "description": "CompletedAt — время завершения в миллисекундах от Unix epoch.",
                    "type": "integer",
                    "x-nullable": true
                },
                "created_at": {
                    "description": "CreatedAt — время приёма в миллисекундах от Unix epoch.",
                    "type": "integer"
                },
                "error_code": {
                    "type": "string",
                    "enum": [
                        "duplicate_audio",
                        "target_unavailable",
                        "unsupported_audio",
                        "processing_failed"
                    ],
                    "x-nullable": true
                },
                "public_id": {
                    "type": "string"
                },
                "status": {
                    "enum": [
                        "queued",
                        "processing",
                        "ready",
                        "failed"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.UploadStatus"
                        }
                    ]
                },
                "track_public_id": {
                    "type": "string",
                    "x-nullable": true
                }
            }
        },
        "dto.UserRequest": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "dto.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "integer"
                },
                "display_name": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "public_id": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                }
            }
        },
        "respond.ErrorBody": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "field": {
                    "type": "string"
                }
            }
        }
    },
